<view class="page">
  <!-- 顶部状态条 -->
  <view class="statusbar">
    <view class="status-pill">
      <view class="dot {{stateText.indexOf('ready') === 0 ? 'dot-ok' : 'dot-warn'}}"></view>
      <text class="status-text">{{stateText}}</text>
    </view>
    <text class="stats-text" wx:if="{{showDebug}}">{{statsText}}</text>
    <text class="disconn-link"
      wx:if="{{stateText.indexOf('ready') === 0}}" bindtap="tapDisconnect">断开</text>
  </view>

  <!-- 主卡：Canvas 仪表 -->
  <view class="card hero-card">
    <canvas type="2d" id="gauge" class="gauge"></canvas>
  </view>

  <!-- 连接操作（未就绪时） -->
  <view class="btn-area" wx:if="{{stateText.indexOf('ready') !== 0}}">
    <button class="wx-btn primary" bindtap="tapConnect">连接车辆</button>
    <button class="wx-btn ghost" bindtap="tapDisconnect">断开连接</button>
  </view>

  <!-- 信息卡片区（就绪后展示） -->
  <block wx:if="{{stateText.indexOf('ready') === 0 && model}}">
    <!-- 电量卡 -->
    <view class="card info-card info-batt">
      <view class="card-title-row">
        <text class="card-title">电池</text>
        <text class="charge-badge" wx:if="{{model.charge.charging}}">充电中</text>
      </view>
      <view class="soc-row">
        <text class="soc-num">{{model.charge.socText}}</text>
        <text class="soc-unit">%</text>
        <text class="soc-range">续航 {{model.charge.rangeText}} km</text>
      </view>
      <view class="soc-bar">
        <view class="soc-fill" style="{{model.charge.socBarStyle}}"></view>
      </view>
      <view class="charge-meta" wx:if="{{model.charge.charging}}">
        <text class="meta-item">功率 {{model.charge.powerText}} kW</text>
        <text class="meta-item">预计完成 {{model.charge.etaText}}</text>
      </view>
    </view>

    <!-- 温度 + 功率 -->
    <view class="grid2">
      <view class="card info-card info-climate half">
        <view class="card-title-row"><text class="card-title">温度</text></view>
        <view class="temp-grid">
          <view class="temp-item">
            <text class="temp-label">车内</text>
            <text class="temp-val">{{model.climate.insideText}}°</text>
          </view>
          <view class="temp-item">
            <text class="temp-label">车外</text>
            <text class="temp-val">{{model.climate.outsideText}}°</text>
          </view>
        </view>
      </view>

      <view class="card info-card info-power half">
        <view class="card-title-row">
          <text class="card-title">功率</text>
          <text class="power-tag {{model.drive.powerDir}}" wx:if="{{model.drive.hasPower && model.drive.powerDir}}">
            {{model.drive.powerDir === 'out' ? '输出' : '回收'}}
          </text>
        </view>
        <view class="power-bar">
          <view class="power-half">
            <view class="power-fill regen" style="{{model.drive.powerRegenStyle}}"></view>
          </view>
          <view class="power-half">
            <view class="power-fill out" style="{{model.drive.powerOutStyle}}"></view>
          </view>
        </view>
        <text class="power-num">{{model.drive.hasPower ? model.drive.powerText + ' kW' : '-- kW'}}</text>
      </view>
    </view>

    <!-- 门与锁 + 胎压 -->
    <view class="grid2">
      <view class="card info-card info-doors half">
        <view class="card-title-row">
          <text class="card-title">门与锁</text>
          <text class="lock-text {{model.locked === true ? 'ok' : (model.locked === false ? 'bad' : '')}}">
            {{model.locked === true ? '已锁定' : (model.locked === false ? '未锁定' : '待数据')}}
          </text>
        </view>
        <!-- 俯视图：开门红色闪烁 -->
        <view class="car-top" wx:if="{{!model.doors.unknown}}">
          <view class="car-body"></view>
          <view class="door-mark d-fl {{model.doors.doors[0].open ? 'is-open' : ''}}"></view>
          <view class="door-mark d-fr {{model.doors.doors[1].open ? 'is-open' : ''}}"></view>
          <view class="door-mark d-rl {{model.doors.doors[2].open ? 'is-open' : ''}}"></view>
          <view class="door-mark d-rr {{model.doors.doors[3].open ? 'is-open' : ''}}"></view>
          <view class="door-mark d-frunk {{model.doors.doors[4].open ? 'is-open' : ''}}"></view>
          <view class="door-mark d-trunk {{model.doors.doors[5].open ? 'is-open' : ''}}"></view>
        </view>
        <view class="doors-unknown" wx:else>等待门状态数据…</view>
      </view>

      <view class="card info-card info-tpms half">
        <view class="card-title-row"><text class="card-title">胎压</text></view>
        <view class="tpms-grid">
          <view class="tpms-item" wx:for="{{model.tpms.values}}" wx:key="name">
            <text class="tpms-name">{{item.name}}</text>
            <text class="tpms-val {{item.low ? 'tp-low' : ''}}">{{item.text}}</text>
          </view>
        </view>
        <text class="tpms-unit">单位 bar · 低于 2.0 告警</text>
      </view>
    </view>
  </block>

  <!-- 调试入口 + 日志面板 -->
  <view class="debug-toggle" bindtap="toggleDebug">{{showDebug ? '收起日志' : '调试日志'}}</view>
  <view class="logs card" wx:if="{{showDebug}}">
    <view class="log-line" wx:for="{{logs}}" wx:key="index">{{item}}</view>
  </view>

  <!-- 配钥弹窗（微信 Modal 风格）：sending / waiting / ok / failed -->
  <view class="wx-mask" wx:if="{{pair.active}}">
    <view class="wx-modal">
      <view class="wx-modal-icon">
        <text class="icon-text" wx:if="{{pair.phase === 'sending'}}">🔑</text>
        <text class="icon-text" wx:elif="{{pair.phase === 'waiting'}}">📶</text>
        <text class="icon-text good" wx:elif="{{pair.phase === 'ok'}}">✓</text>
        <text class="icon-text bad" wx:elif="{{pair.phase === 'failed'}}">!</text>
      </view>
      <view class="wx-modal-title {{pair.phase === 'failed' ? 'bad' : (pair.phase === 'ok' ? 'good' : '')}}">{{pair.title}}</view>
      <view class="wx-modal-body">{{pair.sub}}</view>
      <view class="wx-modal-count" wx:if="{{pair.phase === 'waiting'}}">{{pair.countdown}}s</view>
      <view class="wx-modal-progress" wx:if="{{pair.sends > 0}}">请求 {{pair.sends}}/{{pair.maxSends}}</view>
      <view class="wx-modal-hint">模拟器验证：车端弹窗出现后轻点钥匙卡</view>
    </view>
  </view>
</view>
