<view class="page">
  <view class="statusbar">
    <view class="weather">
      <text class="weather-label">车外</text>
      <text class="weather-value">{{model ? model.climate.outsideText : '--'}}°C</text>
    </view>
    <view class="status-glyphs">
      <view class="state-item"><view class="lamp-icon"></view></view>
      <view class="state-item active"><view class="lamp-icon"></view></view>
      <view class="state-item"><view class="lamp-icon"></view></view>
    </view>
    <view class="clock-group">
      <text class="debug-toggle" bindtap="toggleDebug">{{showDebug ? '收起日志' : '日志'}}</text>
      <text class="clock">{{clock}}</text>
    </view>
  </view>

  <view class="cockpit">
    <view class="side-panel left-panel">
      <image class="car-image" src="../../assets/car-top.png" mode="aspectFit"></image>
    </view>

    <view class="center-panel">
      <view class="speed-ring">
        <view class="speed-inner">
          <text class="speed">{{model ? model.drive.speedText : '--'}}</text>
          <text class="unit">KM/H</text>
          <view class="gear">{{model && model.drive.gearText !== '--' ? model.drive.gearText : 'P'}}</view>
        </view>
      </view>
    </view>

    <view class="side-panel right-panel">
      <view class="vehicle-outline">
        <view class="tire fl"></view>
        <view class="tire fr"></view>
        <view class="tire rl"></view>
        <view class="tire rr"></view>
        <text class="tire-value fl">{{model ? model.tpms.values[0].text : '--'}}</text>
        <text class="tire-value fr">{{model ? model.tpms.values[1].text : '--'}}</text>
        <text class="tire-value rl">{{model ? model.tpms.values[2].text : '--'}}</text>
        <text class="tire-value rr">{{model ? model.tpms.values[3].text : '--'}}</text>
      </view>
      <view class="lock-status" wx:if="{{stateText === 'idle' || stateText.indexOf('error') === 0}}" bindtap="tapConnect">
        <text>设备未连接</text>
        <text class="touch-tip">轻触连接车辆</text>
      </view>
      <text class="link-status" wx:elif="{{stateText.indexOf('ready') !== 0}}">{{stateText}}</text>
      <view class="lock-status" wx:else bindtap="tapDisconnect">
        <text>{{model && model.locked === true ? '设备已锁定' : (model && model.locked === false ? '设备未锁定' : '设备已连接')}}</text>
        <text class="touch-tip">轻触断开</text>
      </view>
    </view>

    <view class="range">
      <view class="range-main">
        <text class="battery-chip">{{model ? model.charge.socText : '--'}}%</text>
        <view class="battery-track">
          <view class="battery-fill" style="{{model ? model.charge.socBarStyle : 'width: 0%'}}"></view>
        </view>
      </view>
      <view class="range-caption">
        <text class="range-label">预估可行驶里程</text>
        <text class="range-value">{{model ? model.charge.rangeText : '--'}} km</text>
      </view>
    </view>
  </view>

  <scroll-view class="logs" wx:if="{{showDebug}}" scroll-y>
    <view class="stats-text">{{statsText}}</view>
    <view class="log-line" wx:for="{{logs}}" wx:key="index">{{item}}</view>
  </scroll-view>

  <!-- 配钥弹窗（微信 Modal 风格）：sending / waiting / ok / failed -->
  <view class="wx-mask" wx:if="{{pair.active}}">
    <view class="wx-modal">
      <view class="wx-modal-icon">
        <text class="icon-text" wx:if="{{pair.phase === 'sending'}}">🔑</text>
        <text class="icon-text" wx:elif="{{pair.phase === 'waiting'}}">📶</text>
        <text class="icon-text good" wx:elif="{{pair.phase === 'ok'}}">✓</text>
        <text class="icon-text bad" wx:elif="{{pair.phase === 'failed'}}">!</text>
      </view>
      <view class="wx-modal-title {{pair.phase === 'failed' ? 'bad' : (pair.phase === 'ok' ? 'good' : '')}}">{{pair.title}}</view>
      <view class="wx-modal-body">{{pair.sub}}</view>
      <view class="wx-modal-count" wx:if="{{pair.phase === 'waiting'}}">{{pair.countdown}}s</view>
      <view class="wx-modal-progress" wx:if="{{pair.sends > 0}}">请求 {{pair.sends}}/{{pair.maxSends}}</view>
      <view class="wx-modal-hint">模拟器验证：车端弹窗出现后轻点钥匙卡</view>
    </view>
  </view>
</view>
