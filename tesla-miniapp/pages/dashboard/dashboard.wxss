.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 4rpx 12rpx 8rpx;
  color: #F5F7FB;
  background:
    radial-gradient(ellipse at 50% 56%, rgba(37, 80, 112, 0.19), transparent 44%),
    radial-gradient(ellipse at 50% 105%, rgba(22, 38, 61, 0.35), transparent 52%),
    #05070B;
}

.statusbar {
  display: flex;
  align-items: center;
  height: 9vh;
  min-height: 42rpx;
  max-height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  color: #D7DBE2;
}

.weather {
  display: flex;
  align-items: baseline;
  width: 23%;
  white-space: nowrap;
}

.weather-label {
  margin-right: 14rpx;
  color: #A8AFBB;
}

.weather-label,
.weather-value {
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.weather-value {
  color: #F5F7FB;
  font-variant-numeric: tabular-nums;
}

.status-glyphs {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.state-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 52rpx;
  color: #626B78;
  opacity: 0.42;
}

.state-item.active {
  color: #F3F6FB;
  opacity: 0.9;
}

.lamp-icon {
  position: relative;
  width: 28rpx;
  height: 30rpx;
}

.lamp-icon::before {
  content: '';
  position: absolute;
  left: 3rpx;
  top: 5rpx;
  width: 13rpx;
  height: 20rpx;
  border-right: 4rpx solid currentColor;
  border-radius: 0 70% 70% 0;
}

.lamp-icon::after {
  content: '';
  position: absolute;
  right: 0;
  top: 6rpx;
  width: 9rpx;
  height: 2rpx;
  background: currentColor;
  box-shadow: 0 7rpx currentColor, 0 14rpx currentColor;
}

.clock-group {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 23%;
}

.debug-toggle {
  margin-right: 20rpx;
  color: #666E7B;
  font-size: 16rpx;
}

.clock {
  color: #F6F7FA;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  font-variant-numeric: tabular-nums;
}

.cockpit {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: calc(91vh - 12rpx);
  min-height: 0;
}

.cockpit::before {
  content: '';
  position: absolute;
  z-index: 0;
  left: 17%;
  right: 19%;
  top: 49%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(151, 221, 246, 0.22), transparent);
  box-shadow: 0 0 28rpx 8rpx rgba(92, 178, 212, 0.10);
}

.side-panel {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 72%;
  min-height: 0;
  box-sizing: border-box;
}

.left-panel {
  width: 19%;
  border-right: 1rpx solid rgba(195, 211, 235, 0.11);
  background: linear-gradient(90deg, transparent, rgba(17, 26, 42, 0.20));
}

.car-image {
  display: block;
  width: 8.2vw;
  min-width: 58px;
  max-width: 116px;
  height: 60vh;
  max-height: 310px;
  transform: scale(1.8);
  filter: drop-shadow(0 5rpx 16rpx rgba(195, 219, 242, 0.13));
}

.center-panel {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  min-width: 0;
}

.speed-ring {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68vh;
  height: 68vh;
  max-width: 42vw;
  max-height: 76%;
  border-radius: 50%;
  background:
    radial-gradient(circle, #020306 0%, #020306 53%, transparent 54%),
    radial-gradient(circle, rgba(160, 191, 203, 0.66) 0%, #35434A 12%, #172027 22%, #0A0D11 34%, transparent 39%);
  box-shadow: 0 0 28rpx rgba(160, 221, 241, 0.14), inset 0 0 25rpx rgba(185, 225, 238, 0.12);
}

.speed-ring::before {
  content: '';
  position: absolute;
  top: 3.5%;
  right: 3.5%;
  bottom: 3.5%;
  left: 3.5%;
  border: 1rpx solid rgba(214, 235, 247, 0.20);
  border-radius: 50%;
  box-shadow: 0 0 24rpx rgba(170, 223, 239, 0.13);
}

.speed-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 54%;
  height: 54%;
  margin-top: -1%;
  border-radius: 50%;
  background:
    radial-gradient(ellipse at 70% 35%, rgba(48, 80, 100, 0.20), transparent 42%),
    radial-gradient(circle, #020306 55%, #06090E 100%);
}

.speed {
  color: #FFFFFF;
  font-size: 6vw;
  font-weight: 350;
  line-height: 1;
  letter-spacing: -4rpx;
  font-variant-numeric: tabular-nums;
}

.unit {
  margin-top: 8rpx;
  color: #868C96;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  font-weight: 300;
}

.gear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 8vh;
  height: 8vh;
  min-width: 36px;
  min-height: 36px;
  max-width: 66px;
  max-height: 66px;
  margin-top: 3vh;
  border: 1rpx solid rgba(116, 214, 239, 0.72);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 25%, #1A414C, #071014 70%);
  box-shadow: 0 0 16rpx rgba(90, 211, 234, 0.22), inset 0 0 9rpx rgba(119, 227, 244, 0.16);
  color: #F7F9FC;
  font-size: 4.5vh;
  font-weight: 600;
}

.right-panel {
  width: 21%;
  border-left: 1rpx solid rgba(195, 211, 235, 0.11);
  background: linear-gradient(270deg, transparent, rgba(17, 26, 42, 0.20));
  gap: 2vh;
}

.vehicle-outline {
  position: relative;
  width: 7vw;
  min-width: 52px;
  max-width: 82px;
  height: 27.2vh;
  min-height: 99px;
  max-height: 184px;
  border: 4rpx solid rgba(192, 194, 203, 0.78);
  border-top-width: 5rpx;
  border-bottom-width: 5rpx;
  border-radius: 48% / 19%;
  filter: drop-shadow(0 0 9rpx rgba(218, 223, 239, 0.08));
}

.vehicle-outline::before {
  content: '';
  position: absolute;
  left: 22%;
  right: 22%;
  top: 25%;
  bottom: 25%;
  border-left: 2rpx solid rgba(170, 173, 185, 0.36);
  border-right: 2rpx solid rgba(170, 173, 185, 0.36);
}

.tire {
  position: absolute;
  z-index: 1;
  width: 12rpx;
  min-width: 8px;
  height: 6vh;
  min-height: 21px;
  max-height: 40px;
  border-radius: 3rpx;
  background: #9799A3;
  box-shadow: 0 0 0 5rpx #11131A;
}

.tire.fl { left: -9rpx; top: 15%; }
.tire.fr { right: -9rpx; top: 15%; }
.tire.rl { left: -9rpx; bottom: 15%; }
.tire.rr { right: -9rpx; bottom: 15%; }

.tire-value {
  position: absolute;
  color: #ABB0BC;
  font-size: 14rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.tire-value.fl { left: -42rpx; top: 19%; }
.tire-value.fr { right: -42rpx; top: 19%; }
.tire-value.rl { left: -42rpx; bottom: 19%; }
.tire-value.rr { right: -42rpx; bottom: 19%; }

.lock-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #F5F7FB;
  font-size: 21rpx;
  font-weight: 550;
  white-space: nowrap;
}

.touch-tip {
  margin-top: 5rpx;
  color: #768091;
  font-size: 14rpx;
  font-weight: 400;
}

.link-status {
  color: #C2C8D2;
  font-size: 18rpx;
  white-space: nowrap;
}

.range {
  position: absolute;
  z-index: 2;
  left: 6%;
  right: 1%;
  bottom: 2.5%;
}

.range-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.battery-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 5vw;
  min-width: 37px;
  max-width: 58px;
  height: 4vh;
  min-height: 22px;
  max-height: 30px;
  border-radius: 8rpx;
  background: #C1C3C9;
  color: #30343B;
  font-size: 18rpx;
  font-weight: 700;
}

.battery-track {
  flex: 1;
  height: 1.5vh;
  min-height: 7px;
  max-height: 12px;
  border-radius: 999rpx;
  background: #292B31;
  overflow: hidden;
}

.battery-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #85D9A4, #49BC7D);
  box-shadow: 0 0 12rpx rgba(91, 220, 147, 0.3);
  transition: width 0.4s ease;
}

.range-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 7rpx;
}

.range-label {
  color: #C6C9D0;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.range-value {
  color: #F5F7FB;
  font-size: 20rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.logs {
  position: fixed;
  z-index: 20;
  left: 12rpx;
  bottom: 12rpx;
  width: 44vw;
  max-height: 42vh;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(195, 211, 235, 0.12);
  border-radius: 12rpx;
  background: rgba(8, 11, 17, 0.94);
}

.stats-text {
  margin-bottom: 6rpx;
  color: #43D9F5;
  font-size: 16rpx;
}

.log-line {
  color: #A5ADBA;
  font-size: 16rpx;
  line-height: 1.6;
  word-break: break-all;
}

.wx-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(4, 5, 6, 0.78);
  backdrop-filter: blur(8rpx);
}

.wx-modal {
  position: relative;
  width: 600rpx;
  box-sizing: border-box;
  padding: 52rpx 44rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 32rpx;
  background: linear-gradient(145deg, #1A1E23, #111417);
  text-align: center;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.48);
}

.wx-modal-icon { margin-bottom: 20rpx; }

.icon-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #2D78FF, #1559D6);
  color: #FFFFFF;
  font-size: 48rpx;
  box-shadow: 0 10rpx 28rpx rgba(45, 120, 255, 0.28);
}

.icon-text.good {
  background: linear-gradient(145deg, #21C15E, #168C43);
  box-shadow: 0 10rpx 28rpx rgba(33, 193, 94, 0.24);
}

.icon-text.bad {
  background: linear-gradient(145deg, #FF453A, #C71F24);
  box-shadow: 0 10rpx 28rpx rgba(232, 33, 39, 0.24);
}

.wx-modal-title {
  margin-bottom: 14rpx;
  color: #F7F9FC;
  font-size: 34rpx;
  font-weight: 700;
}

.wx-modal-title.good { color: #69E9A0; }
.wx-modal-title.bad { color: #FF777B; }

.wx-modal-body {
  color: #AEB5C0;
  font-size: 24rpx;
  line-height: 1.7;
}

.wx-modal-count {
  margin-top: 24rpx;
  color: #43D9F5;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1;
}

.wx-modal-progress {
  margin-top: 18rpx;
  color: #737C89;
  font-size: 20rpx;
}

.wx-modal-hint {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  color: #69717D;
  font-size: 20rpx;
}

@media (max-height: 420px) {
  .statusbar {
    height: 8vh;
    min-height: 36rpx;
  }

  .cockpit {
    height: calc(92vh - 12rpx);
  }

  .side-panel {
    height: 76%;
  }

  .car-image {
    max-height: 70%;
  }

  .speed-ring {
    width: 64vh;
    height: 64vh;
    max-width: 38vw;
  }

  .range {
    bottom: 1%;
  }
}
