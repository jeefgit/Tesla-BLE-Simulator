/* Tesla 横屏驾驶舱 · 微信小程序
 * 克制型深色仪表：顶栏信息 + 车辆 / 车速 / 车锁续航三栏
 * 字号基准偏小，靠留白与细线分层，避免大色块卡片
 */

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  padding: 1vh 2.4vw 1.4vh;
  padding-left: calc(2.4vw + constant(safe-area-inset-left));
  padding-right: calc(2.4vw + constant(safe-area-inset-right));
  padding-left: calc(2.4vw + env(safe-area-inset-left));
  padding-right: calc(2.4vw + env(safe-area-inset-right));
  color: #F3F6FB;
  background:
    radial-gradient(ellipse at 50% 52%, rgba(31, 68, 96, 0.20), transparent 46%),
    radial-gradient(ellipse at 50% 112%, rgba(18, 31, 50, 0.38), transparent 56%),
    #05070B;
}

/* ── 顶栏 ───────────────────────────────────────────────────────── */
.topbar {
  position: relative;
  flex: 0 0 auto;
  height: 11vh;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topbar::after {
  content: '';
  position: absolute;
  left: 12%;
  right: 12%;
  bottom: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(195, 211, 235, 0.10), transparent);
}

.temps {
  display: flex;
  align-items: center;
}

.temp-item {
  display: flex;
  align-items: baseline;
}

.temp-label {
  margin-right: 8rpx;
  color: #7C8593;
  font-size: 14rpx;
  letter-spacing: 2rpx;
}

.temp-value {
  color: #E8EDF4;
  font-size: 20rpx;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}

.temp-c {
  margin-left: 1rpx;
  color: #7C8593;
  font-size: 12rpx;
}

.temp-sep {
  width: 1rpx;
  height: 16rpx;
  margin: 0 22rpx;
  background: rgba(195, 211, 235, 0.16);
}

.mode-status {
  display: flex;
  align-items: center;
  color: #6E7683;
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.mode-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #4E5662;
}

.mode-status.live {
  color: #9FE9C0;
}

.mode-status.live .mode-dot {
  background: #6EDB9A;
  box-shadow: 0 0 10rpx rgba(110, 219, 154, 0.7);
}

.topbar-right {
  display: flex;
  align-items: baseline;
}

.debug-toggle {
  margin-right: 18rpx;
  color: #5F6773;
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.clock {
  color: #F2F4F8;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

/* ── 三栏 ───────────────────────────────────────────────────────── */
.cockpit {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
}

.cockpit::before {
  content: '';
  position: absolute;
  z-index: 0;
  left: 22%;
  right: 23%;
  top: 50%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(151, 221, 246, 0.16), transparent);
  box-shadow: 0 0 24rpx 6rpx rgba(92, 178, 212, 0.08);
}

/* 左：车辆俯视图 */
.left-panel {
  position: relative;
  z-index: 1;
  width: 26%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.left-panel::after {
  content: '';
  position: absolute;
  top: 16%;
  right: 0;
  bottom: 16%;
  width: 1rpx;
  background: linear-gradient(180deg, transparent, rgba(195, 211, 235, 0.12), transparent);
}

.car-stage {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.car-halo {
  position: absolute;
  left: 50%;
  top: 44%;
  width: 144%;
  height: 62%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(90, 178, 212, 0.14), transparent 68%);
}

.car-image {
  position: relative;
  z-index: 1;
  width: 96%;
  height: 76%;
}

.car-floor {
  position: absolute;
  z-index: 0;
  left: 50%;
  bottom: 11%;
  width: 54%;
  height: 6rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(169, 234, 255, 0.20), transparent 72%);
}

.tire-val {
  position: absolute;
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}

.tire-val.fl,
.tire-val.rl {
  left: 1.5%;
  align-items: flex-end;
}

.tire-val.fr,
.tire-val.rr {
  right: 1.5%;
  align-items: flex-start;
}

.tire-val.fl { top: 26%; }
.tire-val.fr { top: 26%; }
.tire-val.rl { top: 62%; }
.tire-val.rr { top: 62%; }

.tire-name {
  color: #59616D;
  font-size: 9rpx;
  letter-spacing: 1rpx;
}

.tire-num {
  color: #9AA3B0;
  font-size: 12rpx;
  font-variant-numeric: tabular-nums;
}

.tire-val.low .tire-num {
  color: #FF777B;
}

/* 中：车速环 */
.center-panel {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-panel::before {
  content: '';
  position: absolute;
  width: 76%;
  height: 82%;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(55, 128, 168, 0.11), transparent 70%);
}

.speed-ring {
  position: relative;
  z-index: 1;
  width: 68vh;
  height: 68vh;
  max-width: 43vw;
  max-height: 43vw;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 50%, #020306 0%, #020306 53%, rgba(2, 3, 6, 0) 54%),
    radial-gradient(circle at 50% 50%, rgba(160, 191, 203, 0.62) 0%, #35434A 12%, #172027 22%, #0A0D11 34%, rgba(10, 13, 17, 0) 39%);
  box-shadow:
    0 0 30rpx rgba(160, 221, 241, 0.10),
    inset 0 0 22rpx rgba(185, 225, 238, 0.08);
}

.speed-ring::before {
  content: '';
  position: absolute;
  top: 3.5%;
  right: 3.5%;
  bottom: 3.5%;
  left: 3.5%;
  border: 1rpx solid rgba(214, 235, 247, 0.18);
  border-radius: 50%;
}

.speed-inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 60%;
  height: 60%;
  margin-top: -1%;
  border-radius: 50%;
  background:
    radial-gradient(ellipse at 70% 35%, rgba(48, 80, 100, 0.16), transparent 42%),
    radial-gradient(circle at 50% 50%, #020306 55%, #06090E 100%);
}

.speed {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.unit {
  margin-top: 3rpx;
  color: #7C8593;
  font-size: 12rpx;
  font-weight: 300;
  letter-spacing: 2rpx;
}

.gear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-top: 7rpx;
  border: 1rpx solid rgba(116, 214, 239, 0.58);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 25%, #1A414C, #071014 70%);
  box-shadow:
    0 0 12rpx rgba(90, 211, 234, 0.18),
    inset 0 0 8rpx rgba(119, 227, 244, 0.12);
  color: #EAF4F8;
  font-size: 17rpx;
  font-weight: 500;
}

/* 右：车锁 + 电量续航 */
.right-panel {
  position: relative;
  z-index: 1;
  width: 23%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.right-panel::before {
  content: '';
  position: absolute;
  top: 16%;
  left: 0;
  bottom: 16%;
  width: 1rpx;
  background: linear-gradient(180deg, transparent, rgba(195, 211, 235, 0.12), transparent);
}

.panel-cap {
  color: #59616D;
  font-size: 11rpx;
  letter-spacing: 3rpx;
}

.lock-block {
  display: flex;
  flex-direction: column;
}

.lock-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.lock-icon {
  position: relative;
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  color: #59616D;
}

.lock-shackle {
  position: absolute;
  left: 9rpx;
  top: 1rpx;
  width: 22rpx;
  height: 19rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-bottom: none;
  border-radius: 11rpx 11rpx 0 0;
  opacity: 0.92;
}

.lock-body {
  position: absolute;
  left: 4rpx;
  bottom: 3rpx;
  width: 32rpx;
  height: 21rpx;
  border-radius: 5rpx;
  background: currentColor;
}

.lock-icon.unlocked .lock-shackle {
  transform: translateX(3rpx) rotate(16deg);
  transform-origin: 70% 100%;
}

.lock-icon.locked { color: #6EDB9A; }
.lock-icon.unlocked { color: #FFA033; }
.lock-icon.offline { color: #4E5662; }

.lock-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.lock-title {
  color: #E8EDF4;
  font-size: 17rpx;
  font-weight: 400;
  line-height: 1.25;
  white-space: nowrap;
}

.lock-title.compact {
  max-width: 100%;
  overflow: hidden;
  color: #B7BEC9;
  font-size: 14rpx;
  text-overflow: ellipsis;
}

.lock-sub {
  margin-top: 2rpx;
  color: #5F6773;
  font-size: 12rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.right-divider {
  height: 1rpx;
  margin: 18rpx 0;
  background: linear-gradient(90deg, rgba(195, 211, 235, 0.13), transparent);
}

.range-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.range-head-right {
  display: flex;
  align-items: baseline;
}

.charging-tag {
  margin-right: 8rpx;
  color: #6EDB9A;
  font-size: 11rpx;
  letter-spacing: 1rpx;
}

.soc-value {
  color: #F2F4F8;
  font-size: 22rpx;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}

.soc-unit {
  margin-left: 2rpx;
  color: #7C8593;
  font-size: 12rpx;
}

.battery-track {
  height: 6rpx;
  margin-top: 11rpx;
  border-radius: 999rpx;
  background: #22262C;
  overflow: hidden;
}

.battery-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #85D9A4, #49BC7D);
  box-shadow: 0 0 10rpx rgba(91, 220, 147, 0.30);
  transition: width 0.4s ease;
}

.range-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 9rpx;
}

.range-label {
  color: #6E7683;
  font-size: 12rpx;
}

.range-value {
  color: #E8EDF4;
  font-size: 18rpx;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}

.range-unit {
  color: #7C8593;
  font-size: 12rpx;
}

/* ── 调试日志 ───────────────────────────────────────────────────── */
.logs {
  position: fixed;
  z-index: 30;
  left: 3vw;
  bottom: 2vh;
  width: 44vw;
  max-height: 44vh;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(195, 211, 235, 0.10);
  border-radius: 12rpx;
  background: rgba(8, 11, 17, 0.95);
}

.logs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.stats-text {
  color: #43D9F5;
  font-size: 13rpx;
}

.logs-close {
  color: #5F6773;
  font-size: 13rpx;
}

.log-line {
  color: #9AA3B0;
  font-size: 13rpx;
  line-height: 1.55;
  word-break: break-all;
}

/* ── 配钥弹窗（横屏横向排版） ────────────────────────────────────── */
.wx-mask {
  position: fixed;
  z-index: 100;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(4, 5, 6, 0.80);
}

.wx-modal {
  display: flex;
  align-items: center;
  width: 520rpx;
  max-width: 66vw;
  max-height: 84vh;
  box-sizing: border-box;
  padding: 22rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background: linear-gradient(145deg, #1A1E23, #111417);
  box-shadow: 0 18rpx 54rpx rgba(0, 0, 0, 0.48);
  overflow: hidden;
}

.wx-modal-icon {
  flex: 0 0 auto;
  margin-right: 22rpx;
}

.icon-text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #2D78FF, #1559D6);
  color: #FFFFFF;
  font-size: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(45, 120, 255, 0.26);
}

.icon-text.good {
  background: linear-gradient(145deg, #21C15E, #168C43);
  box-shadow: 0 6rpx 20rpx rgba(33, 193, 94, 0.22);
}

.icon-text.bad {
  background: linear-gradient(145deg, #FF453A, #C71F24);
  box-shadow: 0 6rpx 20rpx rgba(232, 33, 39, 0.22);
}

.wx-modal-main {
  flex: 1;
  min-width: 0;
}

.wx-modal-title {
  margin-bottom: 5rpx;
  color: #F7F9FC;
  font-size: 24rpx;
  font-weight: 600;
}

.wx-modal-title.good { color: #69E9A0; }
.wx-modal-title.bad { color: #FF777B; }

.wx-modal-body {
  color: #9AA3B0;
  font-size: 17rpx;
  line-height: 1.5;
}

.wx-modal-count {
  margin-top: 6rpx;
  color: #43D9F5;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
}

.wx-modal-progress {
  margin-top: 6rpx;
  color: #5F6773;
  font-size: 14rpx;
}

.wx-modal-hint {
  margin-top: 8rpx;
  padding-top: 7rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  color: #59616D;
  font-size: 13rpx;
}

/* ── 设备选择弹窗 ───────────────────────────────────────────────── */
.scan-modal {
  display: flex;
  flex-direction: column;
  width: 640rpx;
  max-width: 74vw;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 18rpx 22rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background: linear-gradient(145deg, #1A1E23, #111417);
  box-shadow: 0 18rpx 54rpx rgba(0, 0, 0, 0.48);
}

.scan-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.scan-head-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.scan-title {
  color: #F7F9FC;
  font-size: 24rpx;
  font-weight: 600;
}

.scan-vin {
  margin-top: 3rpx;
  color: #5F6773;
  font-size: 14rpx;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

.scan-close {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 4rpx 10rpx;
  color: #9AA3B0;
  font-size: 17rpx;
}

.scan-list {
  height: 46vh;
  margin: 8rpx 0;
}

.scan-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 12rpx 14rpx;
  margin-bottom: 8rpx;
  border: 1rpx solid rgba(195, 211, 235, 0.08);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.02);
}

.scan-item.suggested {
  border-color: rgba(67, 217, 245, 0.42);
  background: rgba(67, 217, 245, 0.06);
}

.scan-item-main {
  flex: 1;
  min-width: 0;
}

.scan-item-title {
  display: flex;
  align-items: center;
}

.scan-name {
  max-width: 44vw;
  overflow: hidden;
  color: #EDF2F9;
  font-size: 19rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.scan-badge {
  flex: 0 0 auto;
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: rgba(67, 217, 245, 0.16);
  color: #43D9F5;
  font-size: 12rpx;
}

.scan-meta {
  display: block;
  margin-top: 3rpx;
  color: #5F6773;
  font-size: 13rpx;
  line-height: 1.4;
  word-break: break-all;
}

.scan-rssi {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #9AA3B0;
  font-size: 14rpx;
}

.scan-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx 16rpx;
}

.scan-empty-text {
  color: #7C8593;
  font-size: 15rpx;
  line-height: 1.6;
  text-align: center;
}

.scan-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.scan-foot-hint {
  flex: 1;
  min-width: 0;
  margin-right: 14rpx;
  color: #7C8593;
  font-size: 13rpx;
  line-height: 1.4;
}

.scan-rescan {
  flex: 0 0 auto;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(67, 217, 245, 0.35);
  border-radius: 10rpx;
  color: #43D9F5;
  font-size: 15rpx;
}
